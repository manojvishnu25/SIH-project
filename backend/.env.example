# AEROVISTA-X Backend Environment Configuration Template
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/aerovista.db

# Pipeline Keyframe & Computer Vision Thresholds
KEYFRAME_INTERVAL_SEC=0.5
BLUR_THRESHOLD=80.0
SIMILARITY_THRESHOLD=0.85
YOLO_MODEL_NAME=yolov8n.pt

# Default GIS Spatial Reference (WGS84)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_ALTITUDE_M=120.5
DEFAULT_SCALE_RATIO=1.0
